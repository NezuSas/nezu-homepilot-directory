# Required in production. Use distinct generated values of at least 32 characters.
DIRECTORY_JWT_SECRET=replace-with-a-random-production-secret-at-least-32-chars
DIRECTORY_POSTGRES_PASSWORD=replace-with-a-random-postgres-password

# Public URL used in invitation, verification and password-reset emails.
PUBLIC_APP_URL=https://directory.example.invalid

# SMTP is optional for local development. Configure all values in production to deliver email.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=HomePilot Directory <no-reply@example.invalid>

# Optional: attempts per IP per minute for account registration and login (default 10).
DIRECTORY_AUTH_RATE_LIMIT_MAX=10